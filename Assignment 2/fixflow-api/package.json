{
  "name": "fixflow-api",
  "version": "1.0.0",
  "description": "FixFlow - Campus Maintenance and Service Dispatch System (NestJS API). Assignment 2, Full Stack Web Development (CS-301), Abdul Raheem 241854",
  "author": "Abdul Raheem (241854)",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "seed": "ts-node src/seed/seed.command.ts",
    "test": "jest --runInBand",
    "test:e2e": "jest --runInBand test/e2e",
    "test:postman": "ts-node scripts/run-postman.ts",
    "token:expired": "ts-node scripts/expired-token.ts",
    "demo:concurrency": "ts-node scripts/concurrency-demo.ts",
    "demo:fake-store": "ts-node scripts/fake-store-demo.ts",
    "openapi": "nest build && node dist/main --export-openapi ../assets/data/openapi.json"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.10",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.10",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.10",
    "@nestjs/swagger": "^11.4.8",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^18.0.10",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "jest": "^29.7.0",
    "newman": "^6.2.3",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": "test/.*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node",
    "testTimeout": 30000,
    "verbose": true,
    "setupFiles": [
      "<rootDir>/test/setup-env.ts"
    ]
  }
}

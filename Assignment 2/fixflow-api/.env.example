# FixFlow configuration. Copy this file to .env and replace the placeholder values.
# .env is ignored by git and must never be submitted.

# HTTP port
PORT=3000

# Secret used to sign JWT access tokens. Use a long random string (at least 32 characters).
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters
# Access-token lifetime: a number of seconds, or a string such as 15m, 1h, 1d
JWT_EXPIRES_IN=1h

# bcrypt cost factor for password hashing (10-12 recommended; tests use 4 for speed)
BCRYPT_ROUNDS=10

# Seed snapshot written by `npm run seed` and loaded into memory on every start
SEED_FILE=data/seed.json

# Print the request-lifecycle trace for the instrumented route (PATCH /api/requests/:id)
LIFECYCLE_TRACE=false

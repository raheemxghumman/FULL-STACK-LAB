                "MEDIUM",
                "HIGH"
              ]
            }
          },
          {
            "name": "page",
            "required": false,
            "in": "query",
            "description": "Default 1.",
            "schema": {
              "minimum": 1,
              "type": "number"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "description": "Default 10, maximum 50.",
            "schema": {
              "minimum": 1,
              "maximum": 50,
              "type": "number"
            }

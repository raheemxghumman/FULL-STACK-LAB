  "info": {
    "title": "FixFlow API",
    "description": "Campus Maintenance and Service Dispatch System. Assignment 2, Full Stack Web Development (CS-301), Abdul Raheem 241854. Log in with POST /api/auth/login, then press Authorize and paste data.accessToken.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "fullName": {
            "type": "string",
            "example": "Hamza Ali",
            "minLength": 3,
            "maxLength": 80
          },
          "email": {
            "type": "string",
            "example": "hamza@fixflow.test",
            "maxLength": 254,
            "format": "email"
          },
          "password": {
            "type": "string",
            "description": "8-72 characters with at least one letter and one digit. Not trimmed or changed.",
            "example": "Campus2026",
            "minLength": 8,
            "maxLength": 72,
            "pattern": "[A-Za-z]"
          }
        },
        "required": [
          "fullName",
          "email",
          "password"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "ali@fixflow.test",
            "format": "email"
          },
          "password": {
            "type": "string",
            "example": "Requester2026",
            "minLength": 1,
            "maxLength": 72
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "CreateCategoryDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Unique (case-insensitive), 3-50 characters.",
            "example": "Carpentry",
            "minLength": 3,
            "maxLength": 50
          },
          "description": {
            "type": "string",
            "description": "10-300 characters.",
            "example": "Wooden fittings, shelves and notice boards.",
            "minLength": 10,
            "maxLength": 300
          },
          "active": {
            "type": "boolean",
            "description": "A real JSON boolean (\"true\" as text is rejected). Defaults to true."
          }
        },
        "required": [
          "name",
          "description"
        ]
      },
      "UpdateCategoryDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 3,
            "maxLength": 50
          },
          "description": {
            "type": "string",
            "minLength": 10,
            "maxLength": 300
          },
          "active": {
            "type": "boolean"
          }
        }
      },
      "CreateRequestDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "5-100 characters.",
            "example": "Projector flickering in Room A-12",
            "minLength": 5,
            "maxLength": 100
          },
          "description": {
            "type": "string",
            "description": "20-1000 characters.",
            "example": "The projector flickers every few seconds and then switches off.",
            "minLength": 20,
            "maxLength": 1000
          },
          "categoryId": {
            "type": "number",
            "description": "An active category id (JSON integer).",
            "example": 3,
            "minimum": 1
          },
          "building": {
            "type": "string",
            "description": "2-80 characters.",
            "example": "Academic Block A",
            "minLength": 2,
            "maxLength": 80
          },
          "room": {
            "type": "string",
            "description": "1-30 characters.",
            "example": "A-12",
            "minLength": 1,
            "maxLength": 30
          },
          "priority": {
            "type": "string",
            "description": "LOW, MEDIUM or HIGH.",
            "example": "HIGH",
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH"
            ]
          }
        },
        "required": [
          "title",
          "description",
          "categoryId",
          "building",
          "room",
          "priority"
        ]
      },
      "UpdateRequestDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 5,
            "maxLength": 100
          },
          "description": {
            "type": "string",
            "minLength": 20,
            "maxLength": 1000
          },
          "categoryId": {
            "type": "number",
            "minimum": 1
          },
          "building": {
            "type": "string",
            "minLength": 2,
            "maxLength": 80
          },
          "room": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30
          },
          "priority": {
            "type": "string",
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH"
            ]
          }
        }
      },
      "AssignRequestDto": {
        "type": "object",
        "properties": {
          "technicianId": {
            "type": "number",
            "description": "Id of an existing technician who supports the request's category.",
            "example": 5,
            "minimum": 1
          }
        },
        "required": [
          "technicianId"
        ]
      },
      "ResolveRequestDto": {
        "type": "object",
        "properties": {
          "resolutionNote": {
            "type": "string",
            "description": "20-1000 characters.",
            "example": "Replaced the faulty HDMI cable and tested the projector.",
            "minLength": 20,
            "maxLength": 1000
          }
        },
        "required": [
          "resolutionNote"
        ]
      },
      "ReopenRequestDto": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "description": "10-500 characters.",
            "example": "The projector is flickering again.",
            "minLength": 10,
            "maxLength": 500
          }
        },
        "required": [
          "reason"
        ]
      },
      "FeedbackDto": {
        "type": "object",
        "properties": {
          "rating": {
            "type": "number",
            "description": "Whole number from 1 to 5.",
            "example": 5,
            "minimum": 1,
            "maximum": 5
          },
          "comment": {
            "type": "string",
            "description": "Optional, up to 500 characters.",
            "example": "Fixed quickly and politely.",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "required": [
          "rating"
        ]
      }
    }
  }
}
    "/api/products": {
      "get": {
        "operationId": "ProductsController_list",
        "parameters": [
          {
            "name": "category",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "all",
                "vases",
                "tableware",
                "tiles",
                "lamps",
                "textiles"
              ]
            }
          },
          {
            "name": "q",
            "required": false,
            "in": "query",
            "description": "Words to search in the name, category and description",
            "schema": {
              "example": "blue vase",
              "type": "string"
            }
          },
          {
            "name": "sort",
            "required": false,
            "in": "query",
            "schema": {
              "default": "featured",
              "type": "string",
              "enum": [
                "featured",
                "price-asc",
                "price-desc",
                "rating",
                "name",
                "newest"
              ]
            }
          },
          {
            "name": "minPrice",
            "required": false,
            "in": "query",
            "schema": {
              "example": 1000,
              "type": "number"
            }
          },
          {
            "name": "maxPrice",
            "required": false,
            "in": "query",
            "schema": {
              "example": 6000,
              "type": "number"
            }
          },
          {
            "name": "inStock",
            "required": false,
            "in": "query",
            "description": "true = only products that are in stock",
            "schema": {
              "type": "string",
              "enum": [
                "true",
                "false"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "List products: filter by category, search, price range and stock; sort",
        "tags": [
          "Products"
        ]
      },
      "post": {
        "operationId": "ProductsController_create",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateProductDto"
              }
            }
          }
        },
        "responses": {
          "401": {
            "description": "Not logged in"
          },
          "403": {
            "description": "Logged in, but not the admin"
          },
          "422": {
            "description": "Invalid fields, listed in details"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Add a product (admin)",
        "tags": [
          "Products"
        ]
      }
    },

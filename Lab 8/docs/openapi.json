  "info": {
    "title": "Kashi Ghar store API",
    "description": "NestJS backend for the Lab 3 e-commerce store (Lab 8, Abdul Raheem 241854). Log in with POST /api/auth/login (demo@kashighar.pk / demo1234, or admin@kashighar.pk / admin1234), then press Authorize and paste the token.",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "The NestJS backend on your computer (npm start in Lab 8/backend)"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "SignupDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Sara Malik"
          },
          "email": {
            "type": "string",
            "example": "sara@example.com"
          },
          "phone": {
            "type": "string",
            "example": "03211234567"
          },
          "city": {
            "type": "string",
            "enum": [
              "Multan",
              "Lahore",
              "Karachi",
              "Islamabad",
              "Rawalpindi",
              "Faisalabad",
              "Peshawar",
              "Quetta",
              "Hyderabad",
              "Sialkot",
              "Bahawalpur",
              "Gujranwala",
              "Other"
            ],
            "example": "Lahore"
          },
          "password": {
            "type": "string",
            "example": "Kashi#2026",
            "minLength": 8
          }
        },
        "required": [
          "name",
          "email",
          "phone",
          "city",
          "password"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "demo@kashighar.pk"
          },
          "password": {
            "type": "string",
            "example": "demo1234"
          },
          "remember": {
            "type": "boolean",
            "description": "Keep the login for 30 days instead of 1",
            "default": false
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "CreateProductDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Kashi Pen Holder"
          },
          "category": {
            "type": "string",
            "enum": [
              "vases",
              "tableware",
              "tiles",
              "lamps",
              "textiles"
            ],
            "example": "tableware"
          },
          "price": {
            "type": "number",
            "example": 900,
            "description": "PKR, whole rupees"
          },
          "oldPrice": {
            "type": "object",
            "example": 1100,
            "description": "Price before the sale; must be higher than price"
          },
          "stock": {
            "type": "number",
            "example": 15
          },
          "description": {
            "type": "string",
            "example": "A small hand-painted pen holder for the study table."
          },
          "art": {
            "type": "string",
            "enum": [
              "a-surahi",
              "a-matka",
              "a-bottle",
              "a-plate",
              "a-bowl",
              "a-mugs",
              "a-tiles",
              "a-hex",
              "a-camel",
              "a-lamp",
              "a-khussa",
              "a-ajrak"
            ],
            "default": "a-plate",
            "description": "Which SVG picture of the store to use"
          },
          "bg": {
            "type": "string",
            "example": "#e6ecf7"
          }
        },
        "required": [
          "name",
          "category",
          "price",
          "stock",
          "description"
        ]
      },
      "UpdateProductDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Kashi Pen Holder"
          },
          "category": {
            "type": "string",
            "enum": [
              "vases",
              "tableware",
              "tiles",
              "lamps",
              "textiles"
            ],
            "example": "tableware"
          },
          "price": {
            "type": "number",
            "example": 900,
            "description": "PKR, whole rupees"
          },
          "oldPrice": {
            "type": "object",
            "example": 1100,
            "description": "Price before the sale; must be higher than price"
          },
          "stock": {
            "type": "number",
            "example": 15
          },
          "description": {
            "type": "string",
            "example": "A small hand-painted pen holder for the study table."
          },
          "art": {
            "type": "string",
            "enum": [
              "a-surahi",
              "a-matka",
              "a-bottle",
              "a-plate",
              "a-bowl",
              "a-mugs",
              "a-tiles",
              "a-hex",
              "a-camel",
              "a-lamp",
              "a-khussa",
              "a-ajrak"
            ],
            "default": "a-plate",
            "description": "Which SVG picture of the store to use"
          },
          "bg": {
            "type": "string",
            "example": "#e6ecf7"
          }
        }
      },
      "CreateReviewDto": {
        "type": "object",
        "properties": {
          "productId": {
            "type": "string",
            "example": "p6"
          },
          "rating": {
            "type": "number",
            "minimum": 1,
            "maximum": 5,
            "example": 5
          },
          "name": {
            "type": "string",
            "example": "Sara Malik"
          },
          "text": {
            "type": "string",
            "example": "The chai mugs arrived safely and look even better in person."
          }
        },
        "required": [
          "productId",
          "rating",
          "name",
          "text"
        ]
      },
      "AddItemDto": {
        "type": "object",
        "properties": {
          "productId": {
            "type": "string",
            "example": "p9"
          },
          "qty": {
            "type": "number",
            "example": 1,
            "default": 1,
            "description": "Never goes above the stock"
          }
        },
        "required": [
          "productId"
        ]
      },
      "SetQtyDto": {
        "type": "object",
        "properties": {
          "qty": {
            "type": "number",
            "example": 2,
            "description": "From 1 to the product's stock"
          }
        },
        "required": [
          "qty"
        ]
      },
      "CouponDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "MULTAN10",
            "description": "MULTAN10 = 10% off, KASHI500 = PKR 500 off orders over PKR 3,000"
          }
        },
        "required": [
          "code"
        ]
      },
      "ContactDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Sara Malik"
          },
          "email": {
            "type": "string",
            "example": "sara@example.com"
          },
          "phone": {
            "type": "string",
            "example": "03211234567"
          }
        },
        "required": [
          "name",
          "email",
          "phone"
        ]
      },
      "ShippingDto": {
        "type": "object",
        "properties": {
          "address": {
            "type": "string",
            "example": "House 7, Street 9, Gulberg III"
          },
          "area": {
            "type": "string",
            "example": "Near Liberty Market"
          },
          "city": {
            "type": "string",
            "enum": [
              "Multan",
              "Lahore",
              "Karachi",
              "Islamabad",
              "Rawalpindi",
              "Faisalabad",
              "Peshawar",
              "Quetta",
              "Hyderabad",
              "Sialkot",
              "Bahawalpur",
              "Gujranwala",
              "Other"
            ],
            "example": "Lahore"
          },
          "postal": {
            "type": "string",
            "example": "54000"
          }
        },
        "required": [
          "address",
          "city",
          "postal"
        ]
      },
      "PaymentDto": {
        "type": "object",
        "properties": {
          "method": {
            "type": "string",
            "enum": [
              "cod",
              "wallet",
              "card"
            ],
            "example": "cod"
          },
          "label": {
            "type": "string",
            "example": "JazzCash",
            "description": "Wallet name (JazzCash or Easypaisa)"
          },
          "account": {
            "type": "string",
            "example": "0300****567",
            "description": "Masked wallet number"
          },
          "last4": {
            "type": "string",
            "example": "4242",
            "description": "Only the last 4 digits of a card. Full card numbers are refused."
          }
        },
        "required": [
          "method"
        ]
      },
      "CreateOrderDto": {
        "type": "object",
        "properties": {
          "cartId": {
            "type": "string",
            "description": "The id from POST /api/carts"
          },
          "deliveryMethod": {
            "type": "string",
            "enum": [
              "standard",
              "express"
            ],
            "default": "standard"
          },
          "contact": {
            "$ref": "#/components/schemas/ContactDto"
          },
          "shipping": {
            "$ref": "#/components/schemas/ShippingDto"
          },
          "payment": {
            "$ref": "#/components/schemas/PaymentDto"
          },
          "notes": {
            "type": "string",
            "example": "Please call before delivery."
          }
        },
        "required": [
          "cartId",
          "contact",
          "shipping",
          "payment"
        ]
      },
      "OrderStatusDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "Processing",
              "Shipped",
              "Delivered",
              "Cancelled"
            ],
            "example": "Cancelled"
          }
        },
        "required": [
          "status"
        ]
      }
    }
  }
}